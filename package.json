{
  "private": true,
  "scripts": {
    "fetch-types": "curl -s http://localhost:33299/plugin-runtime.d.ts -o plugin-runtime.d.ts",
    "build:css": "tailwindcss -i styles.css -o app.css --minify",
    "dev:css": "tailwindcss -i styles.css -o app.css --watch",
    "dev": "npm run dev:css & esbuild app.tsx --bundle --outfile=app.js --jsx=automatic --jsx-import-source=preact --watch",
    "build": "npm run build:css && esbuild app.tsx --bundle --outfile=app.js --jsx=automatic --jsx-import-source=preact",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "lucide-preact": "^1.45.0",
    "preact": "^10.26.5"
  }
}
